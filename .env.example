# Network RPC URL (Base Sepolia testnet)
RPC_URL=https://sepolia.base.org

# Top-up server port
PORT=3000

# Top-up server URL (for client to connect to)
TOPUP_SERVER_URL=http://localhost:3000

# Sponsor private key (with ETH to pay for gas)
SPONSOR_PRIVATE_KEY=your_sponsor_private_key_here

# Unfunded wallet private key (will receive ETH top-ups)
PRIVATE_KEY_UNFUNDED=your_unfunded_wallet_private_key_here

# Recipient address for token transfers
FUNDED_WALLET_ADDRESS=recipient_address_here

# ERC20 token address
TOKEN_ADDRESS=token_contract_address_here

# Top-up configuration
MAX_TOPUPS_PER_ADDRESS=3
GAS_BUFFER_PERCENTAGE=30
