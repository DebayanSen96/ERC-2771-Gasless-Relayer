# Network RPC URL (for local development)
RPC_URL=http://127.0.0.1:8545

# Relayer server port
PORT=3000

# Sponsor private key (with ETH to pay for gas)
SPONSOR_PRIVATE_KEY=your_sponsor_private_key_here

# User private key (with 0 ETH, will be used to sign meta-transactions)
USER_PRIVATE_KEY=your_user_private_key_here

# Contract addresses (will be filled after deployment)
FORWARDER_ADDRESS=
TOKEN_ADDRESS=
